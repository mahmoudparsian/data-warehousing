       "    <tr style=\"text-align: right;\">\n",
       "      <th></th>\n",
       "      <th>num_of_silver_sales_clean</th>\n",
       "    </tr>\n",
       "  </thead>\n",
       "  <tbody>\n",
       "    <tr>\n",
       "      <th>0</th>\n",
       "      <td>16370</td>\n",
       "    </tr>\n",
       "  </tbody>\n",
       "</table>\n",
       "</div>"
      ],
      "text/plain": [
       "   num_of_silver_sales_clean\n",
       "0                      16370"
      ]
     },
     "execution_count": 43,
     "metadata": {},
     "output_type": "execute_result"
    }
   ],
   "source": [
    "con.execute(\"\"\"\n",
    "SELECT count(*) AS num_of_silver_sales_clean \n",
    "FROM silver.sales_clean\n",
    "\"\"\").df()"
   ]
  },
