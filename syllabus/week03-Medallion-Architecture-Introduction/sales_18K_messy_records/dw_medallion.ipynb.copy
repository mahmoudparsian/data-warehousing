   "source": [
    "con.execute(\"\"\"\n",
    "SELECT\n",
    "    s.store_location,\n",
    "    ROUND(SUM(f.profit), 2) AS total_profit\n",
    "FROM gold.fact_sales f\n",
    "JOIN gold.dim_store s ON f.store_key = s.store_key\n",
    "GROUP BY s.store_location\n",
    "ORDER BY total_profit DESC;\n",
    "\"\"\").df()"
   ]
  },
