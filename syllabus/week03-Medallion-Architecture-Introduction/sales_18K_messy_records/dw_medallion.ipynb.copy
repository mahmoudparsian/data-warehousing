   "source": [
    "con.execute(\"\"\"\n",
    "SELECT\n",
    "    sales_channel,\n",
    "    COUNT(*) AS transactions,\n",
    "    ROUND(SUM(final_sale_price), 2) AS total_final_sales,\n",
    "    ROUND(AVG(final_sale_price), 2) AS avg_transaction_value\n",
    "FROM gold.fact_sales\n",
    "GROUP BY sales_channel\n",
    "ORDER BY total_final_sales DESC;\n",
    "\"\"\").df()"
   ]
  },
