   "source": [
    "con.execute(\"\"\"\n",
    "\n",
    "CREATE OR REPLACE TABLE gold.dim_product AS\n",
    "SELECT\n",
    "    ROW_NUMBER() OVER (ORDER BY product_name, product_category, product_brand) AS product_key,\n",
    "    product_name,\n",
    "    product_category,\n",
    "    product_brand\n",
    "FROM (\n",
    "    SELECT DISTINCT\n",
    "        product_name,\n",
    "        product_category,\n",
    "        product_brand\n",
    "    FROM silver.sales_clean\n",
    ");\n",
    "\"\"\")"
   ]
  },
