   "source": [
    "con.execute(\"\"\"\n",
    "CREATE OR REPLACE TABLE gold.dim_store AS\n",
    "SELECT\n",
    "    ROW_NUMBER() OVER (ORDER BY store_location, store_region, store_manager) AS store_key,\n",
    "    store_location,\n",
    "    store_region,\n",
    "    store_manager\n",
    "FROM (\n",
    "    SELECT DISTINCT\n",
    "        store_location,\n",
    "        store_region,\n",
    "        store_manager\n",
    "    FROM silver.sales_clean\n",
    ");\n",
    "\"\"\")"
   ]
  },
